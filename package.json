{
  "name": "spraysense",
  "version": "0.1.0",
  "description": "Predicts the calendar date a pest population crosses its economic threshold",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.ts\"",
    "demo": "node src/cli.ts demo.json",
    "serve": "node --env-file-if-exists=.env src/server.ts",
    "start": "node src/server.ts"
  },
  "dependencies": {
    "framer-motion": "^11.11.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
